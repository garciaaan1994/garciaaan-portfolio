# next/og card images are exported without a .png extension, so Netlify serves
# them as application/octet-stream. Force image/png so all link-preview crawlers
# (X, LINE, Slack, Discord, Facebook…) render them.
/opengraph-image
  Content-Type: image/png
/twitter-image
  Content-Type: image/png
/blog/*/opengraph-image
  Content-Type: image/png
/blog/*/twitter-image
  Content-Type: image/png
